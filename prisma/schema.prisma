// RescueLoop — Private pilot database schema
// PostgreSQL via Neon. Multi-tenant by organisation.
// All tables are tenant-scoped via organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  paused
  suspended
}

enum MemberRole {
  owner
  admin
  member
}

enum InstallationStatus {
  pending
  active
  uninstalled
  revoked
}

enum MembershipStatus {
  active
  trialing
  past_due
  cancelling
  cancelled
  paused_membership
}

enum EnrollmentStatus {
  not_started
  in_progress
  completed
  stalled
}

enum CampaignType {
  activation_rescue
  early_progress_rescue
  mid_course_rescue
  near_finish_rescue
  cancellation_rescue
}

enum CampaignStatus {
  active
  paused
  archived
  draft
}

enum ApprovalMode {
  manual
  automatic
}

enum EligibilityState {
  pending_evaluation
  eligible
  ineligible
  suppressed
  expired
}

enum InterventionState {
  drafted
  awaiting_approval
  approved
  scheduled
  queued
  delivery_attempted
  notification_accepted
  delivered
  failed
  stopped
  dismissed
}

enum DeliveryState {
  queued
  attempted
  api_accepted
  failed
  stopped_before_send
  delivery_unknown
  dead_lettered
}

enum OutcomeState {
  no_response
  opened
  responded
  reminded_later
  requested_help
  opted_out
  course_started
  progress_resumed
  already_completed
}

enum AttributionState {
  unattributed
  observed
  strongly_associated
  confirmed
  estimated
  rejected
}

enum ResponseType {
  continue_course
  stuck
  remind_later
  already_completed
  human_help
  stop_reminders
}

enum BlockerType {
  lack_of_time
  material_difficult
  unsure_next_step
  expected_something_different
  technical_problem
  needs_creator_help
}

enum WebhookStatus {
  received
  processing
  processed
  failed
  duplicate
}

enum AuditAction {
  created
  updated
  deleted
  approved
  dismissed
  scheduled
  suppressed
  unsuppressed
  paused
  resumed
  sent
  delivered
  responded
  opted_out
  synced
  configuration_changed
}

enum DataDeletionStatus {
  requested
  verified
  scheduled
  processing
  completed
  failed
  cancelled
}

enum DataExportStatus {
  Requested
  Processing
  Completed
  Failed
  Expired
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// ─── Accounts and installation ───────────────────────────────

model User {
  id         String               @id @default(cuid())
  whopUserId String?              @unique
  email      String?              @unique
  name       String?
  createdAt  DateTime             @default(now()) @db.Timestamptz()
  updatedAt  DateTime             @updatedAt @db.Timestamptz()
  members    OrganizationMember[]

  @@map("users")
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  slug                   String             @unique
  status                 OrganizationStatus @default(active)
  planTier               String             @default("rescue")
  isPaused               Boolean            @default(false)
  quietHoursStart        String? // "20:00"
  quietHoursEnd          String? // "08:00"
  timezone               String             @default("America/New_York")
  entitlementState       EntitlementState   @default(inactive)
  billingGracePeriodEnds DateTime?          @db.Timestamptz()
  billingManageUrl       String?
  createdAt              DateTime           @default(now()) @db.Timestamptz()
  updatedAt              DateTime           @updatedAt @db.Timestamptz()

  members            OrganizationMember[]
  installations      WhopInstallation[]
  products           Product[]
  courses            Course[]
  mappings           ProductCourseMapping[]
  students           Student[]
  campaigns          Campaign[]
  interventions      Intervention[]
  webhooks           WebhookReceipt[]
  auditLogs          AuditLog[]
  valueEvents        ValueEvent[]
  suppressions       Suppression[]
  deletionRequests   DataDeletionRequest[]
  exportRequests     DataExportRequest[]
  syncExecutions     SyncExecution[]
  syncCheckpoints    SyncCheckpoint[]
  reconciliationRuns ReconciliationRun[]
  onboardingProgress OnboardingProgress[]
  planOverrides      PlanOverride[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(member)
  createdAt      DateTime   @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model WhopInstallation {
  id              String             @id @default(cuid())
  organizationId  String
  whopCompanyId   String             @unique
  status          InstallationStatus @default(pending)
  requestedScopes String // JSON-encoded string array
  grantedScopes   String // JSON-encoded string array
  installedById   String?
  installedAt     DateTime           @default(now()) @db.Timestamptz()
  uninstalledAt   DateTime?          @db.Timestamptz()
  createdAt       DateTime           @default(now()) @db.Timestamptz()
  updatedAt       DateTime           @updatedAt @db.Timestamptz()

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential[]

  @@index([organizationId])
  @@map("whop_installations")
}

model IntegrationCredential {
  id             String    @id @default(cuid())
  installationId String
  keyType        String // "api_key", "webhook_secret", etc.
  encryptedValue String // encrypted at rest
  expiresAt      DateTime? @db.Timestamptz()
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  installation WhopInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@map("integration_credentials")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  whopProductId  String   @unique
  name           String
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  billingCycle   String   @default("monthly") // monthly, annual, one_time
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings     ProductCourseMapping[]
  memberships  Membership[]

  @@index([organizationId])
  @@map("products")
}

model Course {
  id                   String   @id @default(cuid())
  organizationId       String
  externalCourseId     String // Whop course ID
  externalExperienceId String? // Whop experience ID (required for notification delivery)
  name                 String
  lessonCount          Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz()
  updatedAt            DateTime @updatedAt @db.Timestamptz()

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings       ProductCourseMapping[]
  enrollments    Enrollment[]
  studentStates  StudentCourseState[]
  progressEvents ProgressEvent[]

  @@index([organizationId])
  @@map("courses")
}

model ProductCourseMapping {
  id                  String   @id @default(cuid())
  organizationId      String
  productId           String
  courseId            String
  activationDelayDays Int      @default(7)
  isConfirmed         Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campaignLinks Campaign[] // Campaigns that use this mapping as their confirmed mapping

  @@unique([productId, courseId])
  @@index([organizationId])
  @@map("product_course_mappings")
}

// ─── Students and learning state ─────────────────────────────

model Student {
  id             String   @id @default(cuid())
  organizationId String
  whopUserId     String // Whop user ID
  email          String?
  name           String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  enrollments      Enrollment[]
  studentStates    StudentCourseState[]
  progressEvents   ProgressEvent[]
  interventions    Intervention[]
  responses        StudentResponse[]
  blockerResponses BlockerResponse[]
  suppressions     Suppression[]

  @@unique([organizationId, whopUserId])
  @@index([organizationId])
  @@map("students")
}

model Membership {
  id               String           @id @default(cuid())
  organizationId   String
  studentId        String
  productId        String
  whopMembershipId String           @unique
  status           MembershipStatus @default(active)
  joinedAt         DateTime         @db.Timestamptz()
  renewalDate      DateTime?        @db.Timestamptz()
  cancelledAt      DateTime?        @db.Timestamptz()
  priceCents       Int              @default(0)
  currency         String           @default("USD")
  lastSyncedAt     DateTime         @default(now()) @db.Timestamptz()
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @db.Timestamptz()

  student  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  events   MembershipEvent[]
  payments PaymentEvent[]

  @@index([organizationId])
  @@index([studentId])
  @@map("memberships")
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  studentId      String
  courseId       String
  status         EnrollmentStatus @default(not_started)
  enrolledAt     DateTime         @default(now()) @db.Timestamptz()
  createdAt      DateTime         @default(now()) @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([organizationId])
  @@map("enrollments")
}

model StudentCourseState {
  id               String    @id @default(cuid())
  organizationId   String
  studentId        String
  courseId         String
  progressPercent  Int       @default(0)
  lessonsCompleted Int       @default(0)
  totalLessons     Int       @default(0)
  firstActivityAt  DateTime? @db.Timestamptz()
  lastActivityAt   DateTime? @db.Timestamptz()
  lastSyncedAt     DateTime  @default(now()) @db.Timestamptz()
  createdAt        DateTime  @default(now()) @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([organizationId])
  @@map("student_course_states")
}

model ProgressEvent {
  id                    String    @id @default(cuid())
  organizationId        String
  studentId             String
  courseId              String
  externalInteractionId String? // Whop's course_lesson_interaction ID — unique per student+lesson
  lessonId              String? // External lesson ID for precise dedup
  lessonIndex           Int
  lessonTitle           String?
  action                String // "completed", "started", "stalled"
  payloadHash           String? // SHA-256 of interaction payload for dedup
  sourceTimestamp       DateTime? @db.Timestamptz() // When the event occurred at the source
  receivedAt            DateTime  @default(now()) @db.Timestamptz() // When we received it
  sourceVersion         String? // Provider version / etag for staleness checks
  occurredAt            DateTime  @db.Timestamptz()
  webhookReceiptId      String?
  createdAt             DateTime  @default(now()) @db.Timestamptz()

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Prevent the same Whop lesson interaction from being counted twice
  @@unique([organizationId, studentId, externalInteractionId])
  // Payload hash dedup: prevents identical content re-ingestion
  @@unique([organizationId, payloadHash])
  @@index([organizationId, studentId, courseId])
  @@index([occurredAt])
  @@index([sourceTimestamp])
  @@map("progress_events")
}

model MembershipEvent {
  id               String   @id @default(cuid())
  organizationId   String
  membershipId     String
  eventType        String // "created", "activated", "cancelled", "renewed"
  occurredAt       DateTime @db.Timestamptz()
  webhookReceiptId String?
  createdAt        DateTime @default(now()) @db.Timestamptz()

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@map("membership_events")
}

model PaymentEvent {
  id               String        @id @default(cuid())
  organizationId   String
  membershipId     String
  whopPaymentId    String        @unique
  status           PaymentStatus @default(pending)
  amountCents      Int
  currency         String        @default("USD")
  occurredAt       DateTime      @db.Timestamptz()
  webhookReceiptId String?
  createdAt        DateTime      @default(now()) @db.Timestamptz()

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@map("payment_events")
}

// ─── Campaign execution ──────────────────────────────────────

model Campaign {
  id                     String         @id @default(cuid())
  organizationId         String
  type                   CampaignType   @default(activation_rescue)
  name                   String
  status                 CampaignStatus @default(active)
  approvalMode           ApprovalMode   @default(manual)
  maxMessagesPerStudent  Int            @default(2)
  maxMessagesPerOrg      Int            @default(100) // Org-wide message limit per period
  cooldownDays           Int            @default(14)
  quietHoursStart        String         @default("20:00")
  quietHoursEnd          String         @default("08:00")
  stopAfterResponse      Boolean        @default(true)
  stopAfterProgress      Boolean        @default(true)
  stopAfterMembershipEnd Boolean        @default(true)
  messageTemplate        String
  confirmedMappingId     String? // Explicit campaign-to-mapping relationship
  createdAt              DateTime       @default(now()) @db.Timestamptz()
  updatedAt              DateTime       @updatedAt @db.Timestamptz()

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  confirmedMapping ProductCourseMapping? @relation(fields: [confirmedMappingId], references: [id])
  versions         CampaignVersion[]
  interventions    Intervention[]

  @@index([organizationId])
  @@map("campaigns")
}

model CampaignVersion {
  id              String   @id @default(cuid())
  campaignId      String
  versionNumber   Int
  rulesJson       Json // versioned rule snapshot
  messageTemplate String
  createdAt       DateTime @default(now()) @db.Timestamptz()

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@unique([campaignId, versionNumber])
  @@map("campaign_versions")
}

model CampaignRule {
  id         String   @id @default(cuid())
  campaignId String
  ruleType   String // "progress_min", "inactivity_days", etc.
  ruleValue  String
  createdAt  DateTime @default(now()) @db.Timestamptz()

  // Note: rules are versioned via CampaignVersion.rulesJson for historical evidence
  @@map("campaign_rules")
}

model EligibilitySnapshot {
  id                     String           @id @default(cuid())
  organizationId         String
  studentId              String
  campaignId             String
  campaignVersionId      String
  idempotencyKey         String           @unique // Prevents duplicate snapshots on re-run
  state                  EligibilityState @default(pending_evaluation)
  evidenceJson           Json // versioned evidence at detection time
  detectedAt             DateTime         @default(now()) @db.Timestamptz()
  eligibilityWindowStart DateTime?        @db.Timestamptz() // Start of the eligibility evaluation window
  expiresAt              DateTime?        @db.Timestamptz()
  createdAt              DateTime         @default(now()) @db.Timestamptz()

  interventions Intervention[]

  // One immutable snapshot per (student + campaign version + eligibility window)
  @@unique([studentId, campaignVersionId, eligibilityWindowStart])
  @@index([organizationId, studentId])
  @@index([campaignId, state])
  @@map("eligibility_snapshots")
}

model Intervention {
  id                    String            @id @default(cuid())
  organizationId        String
  studentId             String
  campaignId            String
  campaignVersionId     String?
  eligibilitySnapshotId String?
  state                 InterventionState @default(awaiting_approval)
  outcomeState          OutcomeState      @default(no_response)
  attributionState      AttributionState  @default(unattributed)
  priority              String            @default("medium")
  trigger               String
  evidenceJson          Json // stored evidence at creation time
  messagePreview        String
  messageEdited         String?
  idempotencyKey        String            @unique
  approvedById          String?
  approvedAt            DateTime?         @db.Timestamptz()
  scheduledFor          DateTime?         @db.Timestamptz()
  sentAt                DateTime?         @db.Timestamptz()
  respondedAt           DateTime?         @db.Timestamptz()
  recoveredAt           DateTime?         @db.Timestamptz()
  cooldownUntil         DateTime?         @db.Timestamptz()
  createdAt             DateTime          @default(now()) @db.Timestamptz()
  updatedAt             DateTime          @updatedAt @db.Timestamptz()

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion     CampaignVersion?     @relation(fields: [campaignVersionId], references: [id])
  eligibilitySnapshot EligibilitySnapshot? @relation(fields: [eligibilitySnapshotId], references: [id])
  deliveryAttempts    DeliveryAttempt[]
  responses           StudentResponse[]
  valueEvents         ValueEvent[]
  auditLogs           AuditLog[]

  @@index([organizationId, state])
  @@index([studentId])
  @@map("interventions")
}

model DeliveryAttempt {
  id                String        @id @default(cuid())
  interventionId    String
  state             DeliveryState @default(queued)
  attemptNumber     Int           @default(1)
  idempotencyKey    String        @unique
  providerMessageId String? // Whop message ID
  apiAcceptedAt     DateTime?     @db.Timestamptz()
  deliveredAt       DateTime?     @db.Timestamptz()
  failedAt          DateTime?     @db.Timestamptz()
  errorMessage      String?
  retryCount        Int           @default(0)
  nextAttemptAt     DateTime?     @db.Timestamptz()
  createdAt         DateTime      @default(now()) @db.Timestamptz()

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
  @@index([state])
  @@map("delivery_attempts")
}

model StudentResponse {
  id             String       @id @default(cuid())
  interventionId String
  studentId      String
  responseType   ResponseType
  blockerType    BlockerType?
  note           String?
  accessTokenId  String? // Reference to the StudentAccessToken used (not the raw token)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz()

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([interventionId])
  @@index([studentId])
  @@map("student_responses")
}

// Opaque student access tokens.
// The raw token is never stored — only its SHA-256 hash.
// Tokens are scoped to a specific intervention + student + organisation.
model StudentAccessToken {
  id             String    @id @default(cuid())
  organizationId String
  interventionId String
  studentId      String
  tokenHash      String    @unique // SHA-256 hash of the raw token
  expiresAt      DateTime  @db.Timestamptz()
  revokedAt      DateTime? @db.Timestamptz()
  lastUsedAt     DateTime? @db.Timestamptz()
  consumedAt     DateTime? @db.Timestamptz() // Set for one-time actions
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  @@index([organizationId, studentId])
  @@index([interventionId])
  @@map("student_access_tokens")
}

model BlockerResponse {
  id             String      @id @default(cuid())
  organizationId String
  studentId      String
  blocker        BlockerType
  note           String?
  interventionId String?
  createdAt      DateTime    @default(now()) @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, studentId])
  @@map("blocker_responses")
}

model ReminderRequest {
  id             String   @id @default(cuid())
  interventionId String
  studentId      String
  reminderTime   DateTime @db.Timestamptz()
  timezone       String   @default("America/New_York")
  createdAt      DateTime @default(now()) @db.Timestamptz()

  @@index([interventionId])
  @@map("reminder_requests")
}

model Suppression {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  scope          String   @default("organization") // organization, course
  reason         String   @default("student_opt_out")
  interventionId String?
  createdAt      DateTime @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, studentId, scope])
  @@index([organizationId])
  @@map("suppressions")
}

// ─── Trust and attribution ───────────────────────────────────

model WebhookReceipt {
  id             String        @id @default(cuid())
  organizationId String
  whopEventId    String        @unique
  eventType      String
  payloadHash    String
  status         WebhookStatus @default(received)
  attemptCount   Int           @default(0)
  lastError      String?
  receivedAt     DateTime      @default(now()) @db.Timestamptz()
  processedAt    DateTime?     @db.Timestamptz()
  payloadJson    Json // stored for replay/audit

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("webhook_receipts")
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String? // user ID or "system"
  action         AuditAction
  objectType     String // "intervention", "campaign", "organization"
  objectId       String
  interventionId String?
  previousState  String?
  newState       String?
  reason         String?
  metadataJson   Json?
  createdAt      DateTime    @default(now()) @db.Timestamptz()

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention? @relation(fields: [interventionId], references: [id])

  @@index([organizationId, objectType, objectId])
  @@index([interventionId])
  @@map("audit_logs")
}

model ValueEvent {
  id               String           @id @default(cuid())
  organizationId   String
  interventionId   String?
  studentId        String?
  event            String
  attributionLevel AttributionState @default(unattributed)
  amountCents      Int              @default(0)
  currency         String           @default("USD")
  formula          String? // explanation of how the amount was derived
  policyVersion    String           @default("2026-08-01")
  // Reference to the source payment event that created this value event.
  // Unique constraint prevents one payment from creating duplicate value events.
  paymentEventId   String?          @unique
  // Dispute/exclusion state — creator can dispute, exclude, or restore entries
  excluded         Boolean          @default(false)
  disputed         Boolean          @default(false)
  disputeReason    String?
  disputedAt       DateTime?        @db.Timestamptz()
  excludedAt       DateTime?        @db.Timestamptz()
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @db.Timestamptz()

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intervention Intervention?         @relation(fields: [interventionId], references: [id])
  evidence     AttributionEvidence[]

  @@index([organizationId, attributionLevel])
  @@index([interventionId])
  @@index([organizationId, excluded])
  @@map("value_events")
}

model AttributionEvidence {
  id           String   @id @default(cuid())
  valueEventId String
  evidenceType String // "intervention_sent", "course_started", "payment_succeeded"
  evidenceRef  String // reference to source record
  timestamp    DateTime @db.Timestamptz()
  metadataJson Json?
  createdAt    DateTime @default(now()) @db.Timestamptz()

  valueEvent ValueEvent @relation(fields: [valueEventId], references: [id], onDelete: Cascade)

  @@index([valueEventId])
  @@map("attribution_evidence")
}

model DataDeletionRequest {
  id             String             @id @default(cuid())
  organizationId String
  requestedById  String?
  status         DataDeletionStatus @default(requested)
  reason         String?
  verifiedAt     DateTime?          @db.Timestamptz()
  scheduledAt    DateTime?          @db.Timestamptz()
  processedAt    DateTime?          @db.Timestamptz()
  requestedAt    DateTime           @default(now()) @db.Timestamptz()
  completedAt    DateTime?          @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("data_deletion_requests")
}

model DataExportRequest {
  id                String           @id @default(cuid())
  organizationId    String
  requestedById     String?
  status            DataExportStatus @default(Requested)
  downloadToken     String           @unique // Opaque time-limited download token
  downloadExpiresAt DateTime         @db.Timestamptz()
  createdAt         DateTime         @default(now()) @db.Timestamptz()
  completedAt       DateTime?        @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([downloadToken])
  @@index([status])
  @@map("data_export_requests")
}

// ─── Transactional outbox ────────────────────────────────────
// Ensures job dispatch is durable. When application state requires a job:
// 1. Write the domain mutation + OutboxEvent in the same DB transaction
// 2. Commit
// 3. Dispatcher reads pending events and dispatches to Inngest
// 4. Marks dispatched (or failed → dead-letter after retries)

enum OutboxState {
  pending
  dispatching
  dispatched
  failed
  dead_letter
}

model OutboxEvent {
  id              String      @id @default(cuid())
  organizationId  String
  eventType       String // e.g. "whop/webhook.received", "deliver/intervention"
  payloadJson     Json
  state           OutboxState @default(pending)
  idempotencyKey  String      @unique
  attemptCount    Int         @default(0)
  maxAttempts     Int         @default(5)
  lastError       String?
  dispatchedAt    DateTime?   @db.Timestamptz()
  nextAttemptAt   DateTime?   @db.Timestamptz()
  externalEventId String? // Inngest event ID after successful dispatch
  claimedBy       String? // Worker identifier that holds the lease
  claimedAt       DateTime?   @db.Timestamptz() // When the lease was acquired
  leaseExpiresAt  DateTime?   @db.Timestamptz() // When the lease expires
  createdAt       DateTime    @default(now()) @db.Timestamptz()
  updatedAt       DateTime    @updatedAt @db.Timestamptz()

  @@index([organizationId, state])
  @@index([state, nextAttemptAt])
  @@index([state, claimedBy, leaseExpiresAt])
  @@map("outbox_events")
}

model JobExecution {
  id             String    @id @default(cuid())
  organizationId String
  outboxEventId  String?
  jobType        String // e.g. "process-webhook", "deliver-intervention"
  runId          String? // Inngest run ID
  status         String    @default("pending") // pending, running, completed, failed
  startedAt      DateTime? @db.Timestamptz()
  completedAt    DateTime? @db.Timestamptz()
  errorMessage   String?
  metadataJson   Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  @@index([organizationId, status])
  @@index([jobType, status])
  @@map("job_executions")
}

model DeadLetterEvent {
  id             String   @id @default(cuid())
  organizationId String
  outboxEventId  String?
  eventType      String
  payloadJson    Json
  errorMessage   String
  attemptCount   Int
  deadLetteredAt DateTime @default(now()) @db.Timestamptz()
  createdAt      DateTime @default(now()) @db.Timestamptz()

  @@index([organizationId])
  @@map("dead_letter_events")
}

