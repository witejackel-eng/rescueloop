// ─── Synchronization records ─────────────────────────────────

enum SyncExecutionState {
  pending
  running
  completed
  failed
  cancelled
}

enum SyncStageState {
  pending
  running
  completed
  failed
  skipped
}

enum SyncTrigger {
  manual
  scheduled
  webhook
  resumption
}

enum ReconciliationState {
  pending
  running
  completed
  failed
}

model SyncExecution {
  id             String             @id @default(cuid())
  organizationId String
  provider       String             @default("whop")
  environment    String             @default("production")
  trigger        SyncTrigger        @default(manual)
  requestedBy    String? // user ID or "system"
  state          SyncExecutionState @default(pending)
  startedAt      DateTime           @default(now()) @db.Timestamptz()
  completedAt    DateTime?          @db.Timestamptz()
  errorSummary   String?
  jobId          String? // Inngest / external job ID
  createdAt      DateTime           @default(now()) @db.Timestamptz()
  updatedAt      DateTime           @updatedAt @db.Timestamptz()

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages          SyncStage[]
  checkpoints     SyncCheckpoint[]
  reconciliations ReconciliationRun[]

  @@index([organizationId, state])
  @@index([provider, state])
  @@map("sync_executions")
}

model SyncStage {
  id              String         @id @default(cuid())
  syncExecutionId String
  resourceType    String // "courses", "products", "memberships", "progress"
  state           SyncStageState @default(pending)
  startedAt       DateTime       @default(now()) @db.Timestamptz()
  completedAt     DateTime?      @db.Timestamptz()
  pagesProcessed  Int            @default(0)
  recordsRead     Int            @default(0)
  recordsCreated  Int            @default(0)
  recordsUpdated  Int            @default(0)
  recordsSkipped  Int            @default(0)
  retryCount      Int            @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @db.Timestamptz()

  syncExecution SyncExecution @relation(fields: [syncExecutionId], references: [id], onDelete: Cascade)

  @@index([syncExecutionId])
  @@index([resourceType, state])
  @@map("sync_stages")
}

model SyncCheckpoint {
  id                String   @id @default(cuid())
  organizationId    String
  syncExecutionId   String
  resource          String // "courses", "products", "memberships", "progress"
  cursor            String? // Provider cursor for resumption
  sourceWatermark   String? // Provider timestamp / etag for staleness checks
  lastCompletedPage Int      @default(0)
  updatedAt         DateTime @updatedAt @db.Timestamptz()
  createdAt         DateTime @default(now()) @db.Timestamptz()

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncExecution SyncExecution @relation(fields: [syncExecutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resource])
  @@index([organizationId, resource])
  @@map("sync_checkpoints")
}

enum ReconciliationOutcomeClassification {
  matched
  membership_without_course_activity
  course_activity_without_membership
  unmapped_product
  missing_source_fields
  stale_source_record
}

enum ReconciliationResolutionState {
  pending
  resolved
  ignored
  escalated
}

model ReconciliationOutcome {
  id                  String                              @id @default(cuid())
  reconciliationRunId String
  organizationId      String
  studentId           String
  membershipId        String?
  courseId            String
  mappingId           String?
  classification      ReconciliationOutcomeClassification
  resolutionState     ReconciliationResolutionState       @default(pending)
  evidenceJson        Json?
  resolvedAt          DateTime?                           @db.Timestamptz()
  createdAt           DateTime                            @default(now()) @db.Timestamptz()

  reconciliationRun ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)

  @@index([reconciliationRunId])
  @@index([organizationId, classification])
  @@index([studentId])
  @@map("reconciliation_outcomes")
}

model ReconciliationRun {
  id                              String              @id @default(cuid())
  organizationId                  String
  courseId                        String
  syncExecutionId                 String?
  matched                         Int                 @default(0)
  membershipWithoutCourseActivity Int                 @default(0)
  courseActivityWithoutMembership Int                 @default(0)
  unmappedProduct                 Int                 @default(0)
  missingSourceFields             Int                 @default(0)
  staleSourceRecord               Int                 @default(0)
  totalEvaluated                  Int                 @default(0)
  state                           ReconciliationState @default(pending)
  startedAt                       DateTime            @default(now()) @db.Timestamptz()
  completedAt                     DateTime?           @db.Timestamptz()
  createdAt                       DateTime            @default(now()) @db.Timestamptz()
  updatedAt                       DateTime            @updatedAt @db.Timestamptz()

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncExecution SyncExecution?          @relation(fields: [syncExecutionId], references: [id], onDelete: SetNull)
  outcomes      ReconciliationOutcome[]

  @@index([organizationId, courseId])
  @@index([state])
  @@map("reconciliation_runs")
}

// ─── Onboarding ────────────────────────────────────────────────

model OnboardingProgress {
  id               String    @id @default(cuid())
  organizationId   String
  companyId        String
  currentStep      String
  stepsJson        String // JSON-serialized step states
  syncProgressJson String? // JSON-serialized sync progress
  completedAt      DateTime? @db.Timestamptz()
  createdAt        DateTime  @default(now()) @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyId])
  @@map("onboarding_progress")
}
