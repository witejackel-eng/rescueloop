  actorId       String // internal operator identifier
  action        String // e.g. "pilot.review", "sync.retry", "dead-letter.requeue"
  objectType    String // "pilot_application", "outbox_event", "dead_letter", etc.
  objectId      String
  tenantScope   String? // organization ID if tenant-scoped, null if global
  previousState String?
  newState      String?
  reason        String
