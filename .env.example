# Whop app credentials
# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or the real API key.
WHOP_API_KEY=replace_with_your_app_api_key
NEXT_PUBLIC_WHOP_APP_ID=app_replace_me
WHOP_COMPANY_ID=biz_replace_me

# Production database (required in the next backend phase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rescueloop?sslmode=require

# Webhook signing secret (add after creating the Whop webhook)
WHOP_WEBHOOK_SECRET=replace_with_webhook_secret
