# ─── Public (browser-safe) configuration ─────────────────────
# These are safe to expose to the client bundle.

# Whop application ID (from Whop dashboard)
NEXT_PUBLIC_WHOP_APP_ID=

# PostHog analytics project API key
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host URL (e.g. https://us.posthog.com or self-hosted)
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Database ────────────────────────────────────────────────

# Prisma pooled connection string (e.g. postgresql://user:pass@host:port/db?pgbouncer=true)
DATABASE_URL=

# Prisma direct connection string for migrations (no pgbouncer)
DIRECT_URL=

# ─── Whop integration ────────────────────────────────────────

# Whop server-side API key (secret — never expose to client)
WHOP_API_KEY=

# Whop webhook signing secret (used to verify incoming webhook payloads)
WHOP_WEBHOOK_SECRET=

# Default Whop company ID (biz_xxxxxxxxx) for API calls and connection testing
WHOP_COMPANY_ID=

# ─── Core application ────────────────────────────────────────

# Canonical app URL (e.g. https://rescueloop.app)
APP_URL=

# Shared secret to authenticate cron job requests
CRON_SECRET=

# ─── Inngest (durable jobs) ──────────────────────────────────

# Inngest event signing key
INNGEST_EVENT_KEY=

# Inngest job provider secret (optional — used for webhook verification)
JOB_PROVIDER_SECRET=

# ─── Student token signing ───────────────────────────────────

# HMAC signing secret for student share links (min 32 characters)
STUDENT_LINK_SIGNING_SECRET=

# ─── Observability (optional) ────────────────────────────────

# Sentry DSN for error tracking (optional — omit to disable)
SENTRY_DSN=

# ─── Development / testing ───────────────────────────────────

# Set to "true" to enable fixture/demo mode (bypasses real API calls)
RESCUELOOP_FIXTURE_MODE=

# ─── Internal operations workspace ────────────────────────────

# Secret token for authenticating internal operators (min 32 characters).
# Must be provisioned in production. Rotated on a regular schedule.
RESCUELOOP_INTERNAL_TOKEN=
